#!/usr/bin/env bash
# Author: Jeff
# Date: 2026-09-20
# Description: Build the suite from this machine's checkouts and install it for this user
# Notes: Dry run unless --apply, like dotfiles/scripts/install.sh, and it never touches the
#        desktop configuration: ~/.config/hypr and ~/.config/quickshell stay the dotfiles
#        installer's, because two writers for one path is how that breaks.
#        Distribution packaging (a PKGBUILD, pacman, anything that installs outside $HOME)
#        is deliberately out of scope — see docs/PACKAGING-GATE.md
set -euo pipefail

geistos="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
suite="${GEIST_ROOT:-${geistos}/mg-suite}"
prefix="${GEIST_PREFIX:-${HOME}/.local}"
units="${GEIST_UNIT_DIR:-}"
# The record and the units live beside the install they describe, so a run into another
# prefix (a test, a second checkout) never rewrites the ones for ~/.local
if [[ "$prefix" == "${HOME}/.local" ]]; then
    units="${units:-${XDG_CONFIG_HOME:-${HOME}/.config}/systemd/user}"
else
    units="${units:-${prefix}/systemd/user}"
fi
if [[ "$prefix" == "${HOME}/.local" ]]; then
    state="${GEIST_STATE_DIR:-${XDG_STATE_HOME:-${HOME}/.local/state}/geist}"
else
    state="${GEIST_STATE_DIR:-${prefix}/state/geist}"
fi
mode="dry-run"
build="yes"
only=""

usage() {
    cat <<'HELP'
usage: geist-install [--apply] [--skip-build] [--only NAME[,NAME…]] [--check]

  --apply        install; without it, print what would happen and change nothing
  --skip-build   install what is already built rather than building first
  --only         limit to these application directories, e.g. --only mg-calr,mg-feedr
  --check        compare what is installed against the checkouts, then exit

Environment: GEIST_ROOT (suite), GEIST_PREFIX (default ~/.local),
GEIST_UNIT_DIR (default ~/.config/systemd/user).

The desktop configuration is not this script's: run dotfiles/scripts/install.sh for that.
HELP
}

# Every application that ships a binary, and the binaries it ships
# A crate's directory is not always its binary's name, which is why this is explicit
applications() {
    cat <<'APPS'
mg-bookr      mg-bookr
mg-briefr     mg-brief
mg-calcr      mg-calcr
mg-calr       mg-calr
mg-contactr   mg-contacts
mg-feedr      mg-feedr
mg-planr      mg-plan
mg-remindr    mg-remindr
mg-shellr     mg-shellr
mg-streamr    mg-streamr
mg-taskr      mg-taskr
mg-terrm      mg-terrm
mg-vaultr     mg-vault mg-vault-indexd
APPS
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --apply) mode="apply" ;;
        --skip-build) build="no" ;;
        --only) only="${2:?--only needs a list}"; shift ;;
        --check) mode="check" ;;
        -h|--help) usage; exit 0 ;;
        *) printf 'unknown argument: %s\n\n' "$1" >&2; usage >&2; exit 64 ;;
    esac
    shift
done

# Say what a run would do, or is doing
say() { printf '  %s %s\n' "$1" "$2"; }

# Whether this application was asked for
wanted() {
    [[ -z "$only" ]] && return 0
    [[ ",${only}," == *",$1,"* ]]
}

# The commit a checkout is at, marked when it has uncommitted changes
checkout_revision() {
    local dir="$1" revision
    revision="$(git -C "$dir" rev-parse --short HEAD 2>/dev/null || echo unknown)"
    if [[ -n "$(git -C "$dir" status --porcelain 2>/dev/null)" ]]; then
        revision="${revision}+dirty"
    fi
    printf '%s' "$revision"
}

# What the last install recorded for one application
recorded_revision() {
    local app="$1"
    [[ -r "${state}/install-manifest.json" ]] || { printf ''; return; }
    python3 -c 'import json, sys
with open(sys.argv[1]) as handle:
    manifest = json.load(handle)
print(manifest.get("applications", {}).get(sys.argv[2], {}).get("revision", ""))' \
        "${state}/install-manifest.json" "$app" 2>/dev/null || printf ''
}

if [[ "$mode" == "check" ]]; then
    printf 'installed suite\n'
    drift=0
    while read -r app binaries; do
        [[ -z "$app" ]] && continue
        wanted "$app" || continue
        [[ -d "${suite}/${app}" ]] || { say "missing" "$app (no checkout)"; drift=1; continue; }
        current="$(checkout_revision "${suite}/${app}")"
        recorded="$(recorded_revision "$app")"
        installed="yes"
        for binary in $binaries; do
            [[ -x "${prefix}/bin/${binary}" ]] || installed="no"
        done
        if [[ "$installed" == "no" ]]; then
            say "absent " "$app"
            drift=1
        elif [[ "$recorded" != "$current" ]]; then
            say "stale  " "$app (installed ${recorded:-unknown}, checkout ${current})"
            drift=1
        else
            say "current" "$app ($current)"
        fi
    done < <(applications)
    exit "$drift"
fi

printf 'geistos install (%s)\n' "$mode"
printf '  binaries  %s/bin\n  units     %s\n  suite     %s\n\n' "$prefix" "$units" "$suite"

installed_apps=()
while read -r app binaries; do
    [[ -z "$app" ]] && continue
    wanted "$app" || continue
    directory="${suite}/${app}"
    if [[ ! -d "$directory" ]]; then
        say "skip   " "$app — no checkout at $directory"
        continue
    fi

    if [[ "$build" == "yes" ]]; then
        if [[ "$mode" == "apply" ]]; then
            say "build  " "$app"
            (cd "$directory" && cargo build --release --quiet)
        else
            say "build  " "$app (would)"
        fi
    fi

    for binary in $binaries; do
        source="${directory}/target/release/${binary}"
        if [[ "$mode" == "apply" ]]; then
            if [[ ! -x "$source" ]]; then
                printf 'missing build artifact: %s\n' "$source" >&2
                exit 69
            fi
            install -Dm755 "$source" "${prefix}/bin/${binary}"
            say "install" "${prefix}/bin/${binary}"
        else
            say "install" "${prefix}/bin/${binary} (would)"
        fi
    done
    installed_apps+=("$app")
done < <(applications)

# The user units, with @BINDIR@ resolved to where the binaries actually went
printf '\n'
shopt -s nullglob
for template in "${geistos}"/systemd/*.service "${geistos}"/systemd/*.timer; do
    [[ -f "$template" ]] || continue
    name="$(basename "$template")"
    if [[ "$mode" == "apply" ]]; then
        mkdir -p "$units"
        sed "s|@BINDIR@|${prefix}/bin|g" "$template" > "${units}/${name}"
        say "unit   " "${units}/${name}"
    else
        say "unit   " "${units}/${name} (would)"
    fi
done
shopt -u nullglob

# What was installed, and from which commit — so --check can answer honestly later
if [[ "$mode" == "apply" ]]; then
    mkdir -p "$state"
    {
        printf '{\n  "installed_at": "%s",\n  "prefix": "%s",\n  "applications": {\n' \
            "$(date -Is)" "$prefix"
        first="yes"
        for app in "${installed_apps[@]}"; do
            [[ "$first" == "yes" ]] || printf ',\n'
            first="no"
            printf '    "%s": { "revision": "%s" }' "$app" "$(checkout_revision "${suite}/${app}")"
        done
        printf '\n  }\n}\n'
    } > "${state}/install-manifest.json"
    say "record " "${state}/install-manifest.json"
fi

printf '\n'
if [[ "$mode" == "apply" ]]; then
    cat <<NEXT
installed. What this script deliberately did not do:

  desktop config   ~/dotfiles/scripts/install.sh --apply
  enable units     systemctl --user daemon-reload && systemctl --user enable --now mg-feedr mg-streamr mg-streamr-refresh.timer
  create stores    mg-calr database migrate; mg-remindr migration apply

Check ${prefix}/bin is on PATH, then \`geist-install --check\` says whether what is
installed still matches the checkouts.
NEXT
else
    printf 'nothing changed. Run with --apply to install.\n'
fi
